VERSION : 0.1
STRUCT
  "pos1" :
  Struct
    mm : Real := 0.0;
    kN : Real := 0.0;
  END_STRUCT
  ;
  "pos2" :
  Struct
    mm : Real := 0.0;
    kN : Real := 0.0;
  END_STRUCT
  ;
  "pos3" :
  Struct
    mm : Real := 0.0;
    kN : Real := 0.0;
  END_STRUCT
  ;
  "pos4" :
  Struct
    mm : Real := 0.0;
    kN : Real := 0.0;
  END_STRUCT
  ;
  "pos5" :
  Struct
    mm : Real := 0.0;
    kN : Real := 0.0;
  END_STRUCT
  ;
END_STRUCT
;
END_TYPE
