{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "structured_control_language",
      "camelcase": "StructuredControlLanguage",
      "title": "StructuredControlLanguage",
      "scope": "source.structured_control_language",
      "file-types": [
        "scl"
      ],
      "injection-regex": "^structured_control_language$",
      "class-name": "TreeSitterStructuredControlLanguage"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Siemens SCL",
    "authors": [
      {
        "name": "Jens Thieme Almkvist",
        "email": "jens.almkvist@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-structured_control_language"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
