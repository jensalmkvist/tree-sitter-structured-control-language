{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "tree_sitter_scl",
      "camelcase": "TreeSitterScl",
      "title": "tree-siiter scl",
      "scope": "source.tree_sitter_scl",
      "file-types": [
        "scl"
      ],
      "injection-regex": "^tree_sitter_scl$",
      "class-name": "TreeSitterTreeSitterScl"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Sub grammar for .scl files.",
    "authors": [
      {
        "name": "Jens Thieme Almkvist",
        "email": "jens.almkvist@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-tree_sitter_scl"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}